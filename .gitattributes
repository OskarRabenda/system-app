# Normalise line endings so a Windows checkout does not rewrite every file.
* text=auto eol=lf

# Binary — never touch these
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.xlsx binary
*.woff binary
*.woff2 binary

# Generated — collapse in diffs and reviews
package-lock.json linguist-generated=true -diff
client/public/fonts/* linguist-vendored=true
