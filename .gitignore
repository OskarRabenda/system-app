# Dependencies
node_modules/

# Build output
dist/
build/
*.tsbuildinfo
.vite/

# Environment — templates are tracked, real values never are
.env
.env.*
!.env.example

# Secrets / certs
*.pem
*.key

# ---------------------------------------------------------------------------
# Personal data — never commit, never push.
# Put anything real (diet spreadsheets, Apple Health exports, exported
# metrics) in private/ and it stays on this machine.
# ---------------------------------------------------------------------------
/private/
/data/
**/personal/

# Spreadsheets and data dumps anywhere in the tree
*.xlsx
*.xlsm
*.xls
*.csv
*.tsv
*.numbers

# Apple Health export shapes
export.xml
export_cda.xml
apple_health_export/
**/健康/

# Local databases
*.sqlite
*.sqlite3
*.db

# Escape hatch: fixtures and templates are safe to track
!*.example.csv
!*.example.xlsx
!*.sample.csv
!**/fixtures/*.csv

# Uploads (Apple Health exports land here at runtime)
server/uploads/*
!server/uploads/.gitkeep

# Logs & coverage
*.log
npm-debug.log*
coverage/

# Editors
.vscode/
.idea/
*.swp

# OS / OneDrive artefacts
.DS_Store
Thumbs.db
desktop.ini
# Office lock files — this repo lives in OneDrive and will hold spreadsheets
~$*

# Claude Code: keep shared project settings, drop personal and vendored bits.
# skills-lock.json records installed skills so they can be restored.
.claude/settings.local.json
.claude/skills/
